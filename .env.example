# =========================================================
# LEXI - Multi-Agent AI System Environment Configuration
# Duplicate this file to .env and configure your credentials
# =========================================================

# Application Configuration
APP_NAME="LEXI - Multi-Agent AI System"
DEBUG=True

# Database Configuration
# Uses SQLite locally by default. Swap with PostgreSQL in production:
# DATABASE_URL="postgresql://user:password@localhost:5432/lexi_db"
DATABASE_URL="sqlite:///./multi_agent_chatbot.db"

# Security Configuration
# Generate a strong key using: openssl rand -hex 32
JWT_SECRET_KEY="your-jwt-secret-key-here-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Groq API Configuration
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"
LLM_MODEL="llama-3.1-8b-instant"

# Rate Limiting
RATE_LIMIT_PER_MIN=60
